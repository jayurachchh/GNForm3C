    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script>
        //To Prevent Focus Lost on Post Back in Update Panel
        var postbackElement = null;
        function RestoreFocus(source, args) {
            if (postbackElement != null && postbackElement.id != null) {
                var PostBackControl = document.getElementById(postbackElement.id);

                if (PostBackControl != null && typeof (PostBackControl.type) !== 'undefined') {
                    var x = PostBackControl.type;

                    if (x == "select-one")
                        PostBackControl.focus();

                    if (PostBackControl.classList.contains("btnSave"))
                        GNScrollToTop();
                }
            }
        }
        function SavePostbackElement(source, args) {
            postbackElement = args.get_postBackElement();
        }
        function AddRequestHandler() {

            // if (typeof Sys !== 'undefined') {
            var prm = Sys.WebForms.PageRequestManager.getInstance();
            prm.add_endRequest(RestoreFocus);
            prm.add_beginRequest(SavePostbackElement);
            //  }
        }
    </script>

    <!--Google Analytics -->
    <%= PUMIS.CommonFunctions.GetGoogleAnalyticsCode() %>
    <!-- Google Analytics -->
</head>
<body class="page-header-menu-fixed page-container-bg-solid page-footer-fixed" onload="AddRequestHandler()">
    <form id="form1" runat="server">

        <div class="page-wrapper">
            <div class="page-wrapper-row">
                <div class="page-header">
                    <div class="page-header-top">
                        <div class="container-fluid">
                            <div class="page-logo margin-bottom-10 margin-top-10">
                                <asp:HyperLink ID="hlLogo" runat="server" NavigateUrl="~/BidderPanel/BID_Bidder_BidderDashboard.aspx" ToolTip="Logo">
                                    <asp:Image runat="server" ID="imgLogo" Style="max-height: 75px" alt="logo" />
                                </asp:HyperLink>
                            </div>

                            <a href="javascript:;" class="menu-toggler"></a>

                            <div class="top-menu">
                                <ul class="nav navbar-nav pull-right">

                                    <li class="dropdown dropdown-user dropdown-dark">
                                        <a href="javascript:;" class="dropdown-toggle" data-toggle="dropdown" data-hover="dropdown" data-close-others="true">
                                            <asp:Image runat="server" ID="imgCurrentUserPhoto" CssClass="img-circle" AlternateText="" ImageUrl="~/Images/Faculty_NoImg.jpeg" />
                                            <span class="username username-hide-mobile">
                                                <i>Hi,</i>
                                                <asp:Label ID="lblCurrentUsername" CssClass="username username-hide-mobile bold font-green" runat="server" Text="User"></asp:Label>
                                            </span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-default">
                                            <li>
                                                <asp:LinkButton ID="lbtnMyProfile" TabIndex="-1" OnClick="lbtnMyProfile_Click" CausesValidation="false" runat="server"><i class="icon-user"></i>My Profile</asp:LinkButton>
                                            </li>
                                            <li>
                                                <asp:LinkButton ID="lbtnBankDetails" TabIndex="-1" OnClick="lbtnBankDetails_Click" CausesValidation="false" runat="server"><i class="fa fa-credit-card"></i>Bank Details</asp:LinkButton>
                                            </li>
                                            <li>
                                                <asp:LinkButton ID="lbtnLogout" OnClick="lbtnLogout_Click" CausesValidation="false" runat="server"><i class="icon-lock"></i>Log Out</asp:LinkButton>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="page-header-menu">
                        <div class="container-fluid">
                            <div class="hor-menu">
                                <ul class="nav navbar-nav">
                                    <li runat="server">
                                        <asp:HyperLink ID="hlBidderDashboard" runat="server" NavigateUrl="~/BidderPanel/BID_Bidder_BidderDashboard.aspx" Text="Dashboard"></asp:HyperLink>
                                    </li>
                                    <li runat="server" visible="false">
                                        <asp:HyperLink ID="hlBIDTender" runat="server" NavigateUrl="~/BidderPanel/BID_Bidder_BidderAddMany.aspx" Text="Tender Bid "></asp:HyperLink>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page-container">
            <div class="page-head">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12 col-sm-12">
                            <div class="page-title">
                                <h1>
                                    <asp:ContentPlaceHolder ID="cphPageHeader" runat="server">
                                    </asp:ContentPlaceHolder>
                                    <small>
                                        <asp:Label ID="lblPageHeaderBidderName_XXXXX" runat="server"></asp:Label></small>
                                </h1>
                            </div>
                            <div class="page-title pull-right">
                                <asp:ContentPlaceHolder ID="cphPageHeaderRight" runat="server"></asp:ContentPlaceHolder>
                            </div>
                        </div>
                    </div>
                    <div class="page-toolbar">
                    </div>
                </div>
            </div>
            <div class="page-content" style="min-height: 100vh !important;">
                <div class="container-fluid">
                    <ul class="page-breadcrumb breadcrumb" style="padding: 0;">
                        <asp:ContentPlaceHolder ID="cphBreadcrumb" runat="server" Visible="false" EnableViewState="false">
                        </asp:ContentPlaceHolder>
                    </ul>
                    <asp:ContentPlaceHolder ID="cphPageContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
        <div class="page-footer">
            <div class="container-fluid">
                <%=DateTime.Now.Year %> &copy; <%=PUMIS.CV.DefaultUniversityName %>
            </div>
        </div>

        <div class="modal fade" id="viewiFrameReg" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-body">
                    <iframe class="auto-height" allowfullscreen="true" webkitallowfullscreen="true" mozallowfullscreen="true" oallowfullscreen msallowfullscreen="true" style="border: 0px; width: 100%;" onload="this.height=this.contentWindow.document.body.scrollHeight;"></iframe>
                </div>
            </div>
        </div>
        <div class="modal fade" id="viewiFrameLG" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
