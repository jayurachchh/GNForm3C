    <style>
        .page-header.navbar.navbar-fixed-top {
            z-index: 999 !important;
        }

        .page-header.navbar .menu-toggler.sidebar-toggler {
            float: right;
            margin: 0 0 0 0 !important;
        }

        .page-sidebar-closed.page-sidebar-fixed .page-sidebar:hover .page-sidebar-menu > li > a > i[class^="icon-"], .page-sidebar-closed.page-sidebar-fixed .page-sidebar:hover .page-sidebar-menu > li > a > i[class*="icon-"], .page-sidebar .page-sidebar-menu > li > a > i[class^="icon-"], .page-sidebar .page-sidebar-menu > li > a > i[class*="icon-"] {
            color: #cdcdcd !important;
        }

        .page-sidebar-closed.page-sidebar-fixed .page-sidebar:hover .page-sidebar-menu > li:hover > a > i, .page-sidebar-closed.page-sidebar-fixed .page-sidebar:hover .page-sidebar-menu > li.open > a > i, .page-sidebar .page-sidebar-menu > li:hover > a > i, .page-sidebar .page-sidebar-menu > li.open > a > i {
            color: #cdcdcd !important;
        }

        .page-sidebar-closed.page-sidebar-fixed .page-sidebar:hover .page-sidebar-menu > li > a > i, .page-sidebar .page-sidebar-menu > li > a > i {
            color: #cdcdcd !important;
        }

        .nav > li > .hlSupport:focus, .nav > li > .hlSupport:hover {
            background-color: #ed6b75 !important;
        }

        .sticky-label-position {
            display: inline-block !important;
            top: 0% !important;
            left: 50% !important;
            transform: translate(-50%, 0%) !important;
            width: auto !important;
            position: fixed !important;
        }

        .sticky-label-border {
            border: 6px solid !important;
            border-color: #fbe1e3 !important;
            border-radius: 0rem 0rem 1rem 1rem !important;
        }

        .sticky-label-icon {
            color: #ff9800 !important;
        }

        .sticky-label-text {
            font-size: 1.75rem;
            line-height: 1.35 !important;
            background-color: #fbe1e3 !important;
            color: #ed6b75 !important;
            /*font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;*/
            text-align: center !important;
            font-weight: 700 !important;
        }

        /* For Large Desktop View */
        @media screen and (min-width: 1450px) {
            .sticky-label-position {
                max-width: 58rem !important;
                /*position: relative !important;*/
            }
        }

        /* For Desktop View */
        @media screen and (min-width: 1024px) and (max-device-width: 1450px) {
            .sticky-label-position {
                max-width: 58rem !important;
                font-size: 1.65rem;
                line-height: 1.20 !important;
                transform: translate(-80%, 0%) !important;
                /*position: relative !important;*/
            }
        }

        /* For Small Desktop View */
        @media screen and (min-width: 1024px) and (max-device-width: 1450px) {
            .sticky-label-position {
                max-width: 58rem !important;
                font-size: 1.65rem;
                line-height: 1.20 !important;
                transform: translate(-80%, 0%) !important;
                /*position: relative !important;*/
            }
        }

        /* For Tablet View */
        @media screen and (min-device-width: 990px) and (max-device-width: 1024px) {
            .sticky-label-position {
                max-width: 36rem !important;
                font-size: 1.65rem;
                line-height: 1.20 !important;
                transform: translate(-100%, 0%) !important;
            }
        }

        /* For Tablet View */
        @media screen and (min-device-width: 768px) and (max-device-width: 990px) {
            .sticky-label-position {
                max-width: 26rem !important;
                transform: translate(-132%, 0%) !important;
                font-size: 1.45rem;
                line-height: 1.00 !important;
                position: relative !important;
            }
        }

        /* For Mobile Portrait View */
        @media screen and (min-device-width: 1px) and (max-device-width: 768px) {
            .sticky-label-position {
                display: none !important;
            }

            #timerDiv {
                display: none;
            }

            #FeedbackPopup {
                display: none;
            }

            .user {
                width: 50px;
                margin-top: -10px !important;
                margin-right: 5px;
            }

            .usermenu {
                margin-left: -100px !important;
            }

            .userImage {
                height: 27px !important;
            }

            .userDiv {
                width: 49.24px;
                margin-top: -10px !important;
            }
        }

        .button {
            background: none !important;
            border: none;
            color: #c6cfda;
            text-decoration: none !important;
            /*border-radius: 60px;*/
            /*height: 32px;*/
            display: inline-flex;
            align-items: center;
            overflow: hidden;
            width: auto;
            max-width: 33px; /* I'm animating max-width because width needs to be auto, and auto can't be animated */
            -webkit-transition: max-width 1s;
            transition: max-width 1s;
            padding: 19px 35px 10px 10px;
        }

            .button:active {
                color: gold;
            }

            .button:visited {
                color: #c6cfda;
            }

            .button:hover {
                background: none;
                text-decoration: none;
                color: gold;
                /*max-width: 300px;*/
                /*color: #c6cfda;*/
                text-decoration: none;
            }


        .icon {
            font-size: 20px;
            margin-right: 10px;
            /*padding: 0px 8px;*/
            display: flex;
            align-items: center;
        }

        .text {
            white-space: nowrap;
            padding-right: 15px;
        }

        /*.scrollbar-auto {
            /*height: 520px;*/
        /*overflow-y: scroll;*/
        /*}*/
    </style>

    <script>

        function refreshTime() {
            const timeDisplay = document.getElementById("timer");
            const dateString = new Date().toLocaleString();
            const formattedString = dateString.replace(", ", " - ");
            const formatedString = formattedString.split("-", 10)[1];

            timeDisplay.textContent = formatedString;
        }
        setInterval(refreshTime, 1000);
        //To Prevent Focus Lost on Post Back in Update Panel
        var postbackElement = null;
        function RestoreFocus(source, args) {
            if (postbackElement != null && postbackElement.id != null) {
                var PostBackControl = document.getElementById(postbackElement.id);

                if (PostBackControl != null && typeof (PostBackControl.type) !== 'undefined') {
                    var x = PostBackControl.type;

                    if (x == "select-one")
                        PostBackControl.focus();

                    if (PostBackControl.classList.contains("btnSave"))
                        GNScrollToTop();
                }
            }
        }
        function SavePostbackElement(source, args) {
            postbackElement = args.get_postBackElement();
        }
        function AddRequestHandler() {

            if (typeof Sys !== 'undefined') {
                var prm = Sys.WebForms.PageRequestManager.getInstance();
                prm.add_endRequest(RestoreFocus);
                prm.add_beginRequest(SavePostbackElement);
            }
        }
    </script>

    <!--Google Analytics -->
    <%= PUMIS.CommonFunctions.GetGoogleAnalyticsCode() %>
    <!-- Google Analytics -->
</head>
