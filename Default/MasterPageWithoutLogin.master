        <script>

            function OnSuccess(a, b) {
            }
            function OnFailure(a, b, c) {
            }

            $(document).ready(function () {
                InitMain.init();
            });

            $(document).ajaxStart(function () {
                //funBlockUI();

            }).ajaxStop(function () {
                //funUnblockUI();
                InitMain.init();
            });




            if (typeof Sys !== 'undefined') {
                var prm = Sys.WebForms.PageRequestManager.getInstance();

                prm.add_beginRequest(function () {
                    funBlockUI();
                    InitMain.init();
                });
                prm.add_endRequest(function () {
                    funUnblockUI();
                    InitMain.init();

                    /*Old IFrame Modal BEGIN*/
                    $('a.GNModalIFrame').on('click', function (e) {
                        var src = $(this).attr('href');
                        var target = $(this).attr('data-target');

                        $(target + " iframe").attr({
                            'src': src
                        });
                        e.preventDefault();
                    });

                    $('.modal .fade').on('hidden.bs.modal', function () {
                        $(".modal .fade iframe").attr({
                            'src': 'about:blank'
                        });
                    });

                    function closemyModal() {
                        $('.modal').modal('hide');
                    }

                    function closeModalAndRefreshPage() {
                        $('.modal').modal('hide');
                        location.reload();
                    }
                    /*Old IFrame Modal END*/

                });

            }

            /*Old IFrame Modal BEGIN*/
            $('a.GNModalIFrame').on('click', function (e) {
                var src = $(this).attr('href');
                var target = $(this).attr('data-target');

                $(target + " iframe").attr({
                    'src': src
                });
                e.preventDefault();
            });

            $('.modal .fade').on('hidden.bs.modal', function () {
                $(".modal .fade iframe").attr({
                    'src': 'about:blank'
                });
            });

            /*Old IFrame Modal END*/

            function redirectToPage(url) {
                window.location.href = url;
            }

            function toggleModal_lg() {
                $('#Modal_lg').modal('toggle');
                location.reload();
            }

            function ShowHelp() {
                $(".DivHelp").slideToggle('slow');
            }



            function GNHTMLPrint(PageHeader) {

                var x = screen.width / 2 - 1000 / 2;
                var y = screen.height / 2 - 550 / 2;
                var strDomainURL = '<%# HttpContext.Current.Request.Url.GetLeftPart(UriPartial.Authority) %>';

                //var data = document.getElementsByClassName("GNHTMLPrint")[0].innerHTML;

                window.open(strDomainURL + '/Default/HTMLPrint.aspx', "myWindow", 'width=800,height=800,left=' + x + ',top=' + y);   // Opens a new window
                //window.onafterprint = window.history.back();
                //window.location.replace(window.location.href);
                //mywindow.document.write('<html><head><title>' + PageHeader + '</title>');
                //mywindow.document.write('</head><body >');
                //mywindow.document.write(data);
                //mywindow.document.write('</body></html>');
                //mywindow.print();
                //mywindow.close();
                //event.preventDefault();
                return true;
            }

            function HTMLPrintStudentCertificate(StudentCertificateRequestTranID, Isheader) {

                var x = screen.width / 2 - 1000 / 2;
                var y = screen.height / 2 - 550 / 2;
                var strDomainURL = '<%# HttpContext.Current.Request.Url.GetLeftPart(UriPartial.Authority) %>';
                var mywindow = window.open(strDomainURL + '/Default/HTMLPrintStudentCertificate.aspx?StudentCertificateRequestTranID=' + StudentCertificateRequestTranID + '&Isheader=' + Isheader, "myWindow", 'width=1000,height=600,left=' + x + ',top=' + y);   // Opens a new window
                //window.open(strDomainURL + '/Default/HTMLPrintStudentCertificate.aspx?StudentCertificateRequestID=' + StudentCertificateRequestTranID + '&Isheader=' + Isheader, "myWindow", 'width=800,height=800,left=' + x + ',top=' + y);   // Opens a new window
                return true;
            }

            function ScrolltoTop(Control) {
                ScrollToSearch(Control);
            }


        </script>
